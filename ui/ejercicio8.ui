  <property name="styleSheet">
   <string notr="true">/* =========================
   ESTILO GENERAL DEL DIALOG
   ========================= */
QDialog {
    background-color: #f4f6f9;
    border: 1px solid #d6dce5;
    border-radius: 12px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    color: #2c3e50;
}

/* =========================
   LABELS
   ========================= */
QLabel {
    color: #34495e;
    font-weight: 500;
    background: transparent;
}

/* =========================
   CAMPOS DE TEXTO
   ========================= */
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #d0d7de;
    border-radius: 8px;
    padding: 8px 10px;
    color: #2c3e50;
    selection-background-color: #4a90e2;
    selection-color: white;
}

/* Cuando el usuario selecciona el campo */
QLineEdit:focus {
    border: 2px solid #4a90e2;
    background-color: #ffffff;
}

/* Campo deshabilitado */
QLineEdit:disabled {
    background-color: #ecf0f1;
    color: #95a5a6;
    border: 2px solid #dfe6e9;
}

/* =========================
   BOTONES
   ========================= */
QPushButton {
    background-color: #4a90e2;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
}

/* Hover */
QPushButton:hover {
    background-color: #357abd;
}

/* Click */
QPushButton:pressed {
    background-color: #2f6da3;
    padding-top: 9px;
    padding-bottom: 7px;
}

/* Botón deshabilitado */
QPushButton:disabled {
    background-color: #bdc3c7;
    color: #ecf0f1;
}

/* =========================
   TOOLTIP OPCIONAL
   ========================= */
QToolTip {
    background-color: #2c3e50;
    color: white;
    border: 1px solid #4a90e2;
    padding: 5px;
    border-radius: 6px;
}</string>
